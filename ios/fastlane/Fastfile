# TestFlight upload lane.
#
# Runs on GitHub Actions (see .github/workflows/testflight.yml) using an
# App Store Connect API key. Signing is MANUAL, backed by fastlane match:
# the Apple Distribution certificate and the App Store provisioning profiles
# for the app + widget are created once and stored (encrypted with
# MATCH_PASSWORD) in a git branch, then reused on every later run. This ends
# the "new distribution certificate every build → hit the 2-cert cap" churn
# that plain `cert` caused on ephemeral CI runners.
#
# Prerequisites (one-time):
#   - App IDs jp.keio.klms.klmsApp and .KlmsWidgets registered with the App
#     Groups capability assigned to group.jp.keio.klms.klmsApp.
#   - The App Store Connect *app record* for jp.keio.klms.klmsApp.
#   - Before the FIRST match run, any leftover Apple Distribution certificates
#     must be revoked so match can create and store a fresh one.
#
# Required environment:
#   ASC_KEY_ID / ASC_ISSUER_ID                (App Store Connect API key)
#   ASC_KEY_P8_PATH    absolute path to the key written as strict-PEM .p8
#   BUILD_NUMBER       monotonically increasing integer (e.g. GitHub run number)
#   MATCH_PASSWORD     passphrase that encrypts the stored certs/profiles
#   MATCH_GIT_URL / MATCH_GIT_BRANCH / MATCH_GIT_BASIC_AUTHORIZATION
#                      where and how match stores the encrypted signing files

default_platform(:ios)

TEAM_ID = "NNU983LGZU".freeze
MARKETING_VERSION = "0.1.0".freeze
APP_ID = "jp.keio.klms.klmsApp".freeze
WIDGET_ID = "jp.keio.klms.klmsApp.KlmsWidgets".freeze

platform :ios do
  desc "Build a signed IPA and upload it to TestFlight"
  lane :beta do
    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")
    p8_path = ENV.fetch("ASC_KEY_P8_PATH")
    build_number = ENV.fetch("BUILD_NUMBER")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: p8_path,
    )

    # On CI, create/unlock a temporary keychain (match installs the cert into
    # it via the MATCH_KEYCHAIN_* env vars setup_ci sets).
    setup_ci

    # Fetch (or, on the first run, create + store) the distribution cert and
    # App Store profiles for both targets. App Groups is already enabled on the
    # App IDs, so the generated profiles carry that entitlement. git storage is
    # configured via MATCH_GIT_* / MATCH_PASSWORD env vars from the workflow.
    match(
      type: "appstore",
      api_key: api_key,
      app_identifier: [APP_ID, WIDGET_ID],
      readonly: false,
    )

    mapping = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] || {}
    app_profile = mapping[APP_ID] ||
      ENV["sigh_#{APP_ID}_appstore_profile-name"]
    widget_profile = mapping[WIDGET_ID] ||
      ENV["sigh_#{WIDGET_ID}_appstore_profile-name"]
    UI.user_error!("match did not return provisioning profile names") \
      if app_profile.nil? || widget_profile.nil?

    # Switch the two app targets (not Pods) to manual signing with those
    # profiles. CURRENT_PROJECT_VERSION is forced so the widget's CFBundleVersion
    # matches the app's (App Store requirement).
    update_code_signing_settings(
      path: "Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: TEAM_ID,
      targets: ["Runner"],
      code_sign_identity: "Apple Distribution",
      bundle_identifier: APP_ID,
      profile_name: app_profile,
    )
    update_code_signing_settings(
      path: "Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: TEAM_ID,
      targets: ["KlmsWidgets"],
      code_sign_identity: "Apple Distribution",
      bundle_identifier: WIDGET_ID,
      profile_name: widget_profile,
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} " \
        "MARKETING_VERSION=#{MARKETING_VERSION}",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: {
          APP_ID => app_profile,
          WIDGET_ID => widget_profile,
        },
      },
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end
