# TestFlight upload lane.
#
# Runs on GitHub Actions (see .github/workflows/testflight.yml) using an
# App Store Connect API key only — no local certificates: signing is done
# by Xcode "cloud signing" (-allowProvisioningUpdates + the API key), which
# also auto-registers the bundle IDs (app + widget) and their capabilities
# on first run.
#
# The App Store Connect *app record* cannot be created with an API key via
# fastlane (produce requires Apple ID login), so it is created manually once:
# App Store Connect → マイApp → 「+」→ 新規App → Bundle ID: jp.keio.klms.klmsApp.
# Until it exists, the upload step fails with "Could not find app" — the
# archive/signing part still validates.
#
# Required environment:
#   ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_P8   (App Store Connect API key)
#   ASC_KEY_P8_PATH    absolute path to the same key written as a .p8 file
#   BUILD_NUMBER       monotonically increasing integer (e.g. GitHub run number)

default_platform(:ios)

TEAM_ID = "NNU983LGZU".freeze
MARKETING_VERSION = "0.1.0".freeze

platform :ios do
  desc "Build a signed IPA and upload it to TestFlight"
  lane :beta do
    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")
    p8_path = ENV.fetch("ASC_KEY_P8_PATH")
    build_number = ENV.fetch("BUILD_NUMBER")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: ENV.fetch("ASC_KEY_P8"),
    )

    # --- Archive + export with Xcode cloud signing. ---
    # DEVELOPMENT_TEAM is forced globally (the project file doesn't carry a
    # team), and CURRENT_PROJECT_VERSION likewise so the widget extension's
    # CFBundleVersion matches the app's (App Store requirement).
    auth_args = "-allowProvisioningUpdates " \
      "-authenticationKeyPath #{p8_path} " \
      "-authenticationKeyID #{key_id} " \
      "-authenticationKeyIssuerID #{issuer_id}"
    # CODE_SIGN_IDENTITY is forced to the distribution certificate so the
    # archive signs with an App Store profile directly — development
    # profiles would require a registered device, which this team has none.
    build_settings = "DEVELOPMENT_TEAM=#{TEAM_ID} CODE_SIGN_STYLE=Automatic " \
      "CODE_SIGN_IDENTITY='Apple Distribution' " \
      "CURRENT_PROJECT_VERSION=#{build_number} " \
      "MARKETING_VERSION=#{MARKETING_VERSION}"
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      xcargs: "#{auth_args} #{build_settings}",
      export_xcargs: auth_args,
      export_options: {
        signingStyle: "automatic",
        teamID: TEAM_ID,
      },
    )

    # --- Upload to TestFlight. ---
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end
